PORT=5001

# Database Engine Selection: 'mysql' (XAMPP default), 'postgres', or 'auto'
DB_DIALECT=mysql

# PostgreSQL Configuration (Port 5432)
PGHOST=localhost
PGPORT=5432
PGDATABASE=blacksite_armory
PGUSER=postgres
PGPASSWORD=postgres

# XAMPP MySQL / MariaDB Configuration (Port 3306)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=blacksite_armory
MYSQL_USER=root
MYSQL_PASSWORD=

CLIENT_URL=http://localhost:5173
NODE_ENV=development
