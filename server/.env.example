PORT=5001

# Database Engine Selection: 'auto' (detects active engine), 'postgres', or 'mysql'
DB_DIALECT=auto

# PostgreSQL Configuration (Port 5432)
PGHOST=localhost
PGPORT=5432
PGDATABASE=blacksite_armory
PGUSER=postgres
PGPASSWORD=postgres

# XAMPP MySQL / MariaDB Configuration (Port 3306)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=blacksite_armory
MYSQL_USER=root
MYSQL_PASSWORD=

CLIENT_URL=http://localhost:5173
NODE_ENV=development
